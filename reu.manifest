; backlot-64 REU image layout (see docs/PLAN.md, REU layout)
size    16384
header  $4FF000          ; the image's own description: magic, format, layout hash, slot table (b64pack.py)
slot    WORLD     $000000  build/world.map
slot    REGIONS   $400000  build/world.reg
slot    TILESET0  $401000  build/bellamar_day.bin
slot    SPRITES0  $431000  build/sprites0.spr
slot    NIGHTSET  $500000  build/night-parked.still
slot    CRUISERGRID $503000  build/cruiser.grid
slot    CRUISERBLOCK $504000 build/cruiser.bblock
slot    LAMP      $505000  build/lamp.spr
slot    BLOCK     $505040  build/block.spr   ; the multiplexer harness's sprite
slot    ULTIMATE  $505080  build/ultimate.bin ; the C64 Ultimate module, fetched into region B at boot
slot    CRUISEROBJ $506000 build/cruiser.b64o
slot    SCENE     $507000  build/scene.bin
slot    BENCH     $508000  build/benchscripts.bin
slot    OVL1      $509000  build/ovl1.bin      ; example code overlays for region A
slot    OVL2      $50B000  build/ovl2.bin
slot    DAYSET    $50D000  build/day.still     ; the showcase: day set, its 32 dusk states, the strobe states, the script
slot    DAYLIGHT  $510000  build/daylight.bin
slot    NIGHTLIGHT $520000 build/nightlight.bin
slot    SHOW      $560000  build/show.bin
slot    PHYSICS   $561000  build/physics.bin   ; the physics module, pinned at $6000 (docs/PHYSICS.md)
slot    CARS16    $563000  build/cars16.spr    ; a sedan at 16 headings (tools/b64rot.py)
slot    COLLISION $564000  build/collision.bin ; the collision module, for region A (docs/PHYSICS.md)
slot    WATER     $565000  build/water.bin     ; the water physics module, swapped with PHYSICS at $6000
slot    BOATS16   $567000  build/boats16.spr   ; a speedboat at 16 headings (tools/b64rot.py)
slot    AIR       $568000  build/air.bin       ; the air physics module, swapped with PHYSICS at $6000
slot    PLANE16   $56A800  build/plane16.spr   ; a light plane at 16 headings
slot    PLANESH16 $56AC00  build/planesh16.spr ; its shadow
slot    AIRBOAT16 $56B000  build/airboat16.spr ; an airboat at 16 headings
slot    AI        $56C000  build/ai.bin        ; the AI module, for region A at $8D00 (docs/AI.md)
slot    CUT       $56D000  build/cut.bin       ; the cutscene module, region A while a scene plays (src/b64_scene.s)
slot    MODTAB    $56E000  -                   ; the module table, written by the packer from the lines below
slot    MODSCRIPT $56E400  build/modscript.bin ; examples/modules: the game in p-code
slot    MODOPS    $56F000  build/modops.bin    ; and its own module, the handlers of its game opcodes
slot    HELI16    $570000  build/heli16.spr    ; a helicopter at 16 headings by 4 blade phases (4 KB)
slot    HELISH16  $571000  build/helish16.spr  ; its shadow, the same outline in one colour

; the modules the VM loads and unloads (docs/MODULES.md): each names its slot,
; where it runs, what it provides and requires; the VM never evicts a module
; another resident module requires
module  PHYS_GROUND PHYSICS    base=$6000 size=$1A00 provides=PHYS:1 swap=5 default
module  PHYS_WATER  WATER      base=$6000 size=$1A00 provides=PHYS:1 swap=5
module  PHYS_AIR    AIR        base=$6000 size=$1A00 provides=PHYS:1 swap=5
module  COLLISION   COLLISION  base=$8000 size=$0D00 provides=COL:1 requires=PHYS:1 default
module  AI          AI         base=$8D00 size=$0B00 provides=AI:1 requires=PHYS:1,COL:1 default
; examples/modules: the game's own module, and the overlay example's first
; overlay, which the manager must refuse while the collision module is needed
module  DEMO_OPS    MODOPS     base=$3800 size=$0400 provides=DEMO:1 default
module  OVERLAY1    OVL1       base=$8000 size=$0400
; the game opcodes (80-127): number, name, module, entry of its jump table
op      80 DRAW     DEMO_OPS 0
op      81 SHOW     DEMO_OPS 1
slot    HEAP8     $600000  -        ; game heap on an 8 MB REU (see B64_HEAP8)
slot    SCRATCH   $7F0000  -
slot    HEAP16    $800000  -        ; game heap on a 16 MB REU: only when b64_plat has REU16
